# ==============================================================================
# APPLICATION & SERVER CONFIGURATION
# ==============================================================================
APP_NAME=demo
SERVER_PORT=3000
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000
SPRING_WEB_ERROR_INCLUDE_MESSAGE=always

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Local PostgreSQL
DBURL=jdbc:postgresql://localhost:5432/manager
DB_URL=jdbc:postgresql://localhost:5432/manager
DB_USERNAME=postgres
DBPass=your_postgres_password
DB_PASSWORD=your_postgres_password

# ==============================================================================
# SECURITY & JWT CONFIGURATION
# ==============================================================================
# Base64 encoded secret key (minimum 256-bit / 32 bytes for HS256)
JWT_SECRET=bXlTZWNyZXRrZXkxMjM0NTY3ODkwbXlTZWNyZXRrZXkxMg
JWT_EXPIRATION_MS=30002230946
JWT_COOKIE_NAME=PaimanaBackend

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4200,http://127.0.0.1:8000

# ==============================================================================
# AI / GOOGLE GEMINI CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ==============================================================================
# JPA / HIBERNATE CONFIGURATION
# ==============================================================================
SPRING_JPA_DEFER_DATASOURCE_INITIALIZATION=true
SPRING_JPA_FORMAT_SQL=true
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
